# Writes iex_bench's source-provenance header. Run with cmake -P on EVERY
# build (an always-out-of-date custom target), so the stamp tracks the working
# tree, not the tree at configure time.
#
#   -DREPO=<repo root> -DOUT=<header path>
#
# PKMN_BENCH_GIT_SHA   short HEAD, plus "-dirty" when `git status --porcelain
#                      -- cpp scripts` is non-empty (modified, staged, deleted
#                      OR untracked, honouring .gitignore).
# PKMN_BENCH_TREE_HASH "" when clean; else SHA-256 of `git diff HEAD -- cpp
#                      scripts` followed by each untracked file's path and
#                      contents (sorted), so a -dirty result names exact source.
# The header is replaced only when its content changes, so an unchanged tree
# does not recompile iex_bench.

execute_process(COMMAND git -C "${REPO}" rev-parse --short=12 HEAD
                OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
set(tree_hash "")
if(NOT rc EQUAL 0 OR NOT sha)
  set(sha "unknown")
else()
  execute_process(COMMAND git -C "${REPO}" status --porcelain -- cpp scripts
                  OUTPUT_VARIABLE status ERROR_QUIET)
  if(NOT status STREQUAL "")
    set(sha "${sha}-dirty")
    execute_process(COMMAND git -C "${REPO}" diff --binary HEAD -- cpp scripts
                    OUTPUT_VARIABLE blob ERROR_QUIET)
    execute_process(COMMAND git -C "${REPO}" ls-files --others --exclude-standard -- cpp scripts
                    OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT untracked STREQUAL "")
      string(REPLACE "\n" ";" untracked "${untracked}")
      list(SORT untracked)
      foreach(f IN LISTS untracked)
        file(READ "${REPO}/${f}" content HEX)
        string(APPEND blob "\nuntracked ${f}\n${content}")
      endforeach()
    endif()
    string(SHA256 tree_hash "${blob}")
  endif()
endif()

set(text "// Generated by cpp/cmake/bench_build_info.cmake on every build. Do not edit.\n")
string(APPEND text "#pragma once\n#define PKMN_BENCH_GIT_SHA \"${sha}\"\n#define PKMN_BENCH_TREE_HASH \"${tree_hash}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
